+// Copyright (c) Cratis. All rights reserved.
+// Licensed under the MIT license. See LICENSE file in the project root for full license information.
+
+using Cratis.Screenplay.Semantics;
+using Cratis.Stage.Contracts.Rendering;
+using Cratis.Stage.Rendering.Cratis.Naming;
+
+namespace Cratis.Stage.Rendering.Cratis.Semantics;
+
+internal static partial class SemanticCratisAdmission
+{
+    static void ValidatePerformedQueries(SemanticApplicationContext context, SemanticSlice slice, List<ArtifactRenderDiagnostic> diagnostics)
+    {
+        foreach (var query in context.PerformedQueries.Where(query => query.Slice.Slice.Id == slice.Id))
+        {
+            if (PerformedQueryRejection(context, query) is { } reason)
+            {
+                diagnostics.Add(Error("STAGE-ESM-066", $"Performer query '{query.Name}' cannot render: {reason}.", query.Id));
+            }
+        }
+    }
+
+    static string? PerformedQueryRejection(SemanticApplicationContext context, SemanticPerformedQuery query)
+    {
+        if (query.Shape is not { } shape)
+        {
+            return "its compiler requirement has no query shape";
+        }
+        if (shape.ReadModel is not { } id || !context.ReadModels.TryGetValue(id, out var model))
+        {
+            return "its returned read model is unresolved";
+        }
+        if (!query.Slice.Slice.ReadModels.Any(model => model.Id == id))
+        {
+            return "its returned read model belongs to another slice";
+        }
+        if (context.Application.Policies.Length > 0)
+        {
+            return "the model declares policies but the opaque query descriptor does not carry authorization metadata";
+        }
+        if (shape.Cardinality is not (SemanticQueryCardinality.One or SemanticQueryCardinality.ZeroOrOne or SemanticQueryCardinality.Many) ||
+            shape.Delivery is not (SemanticQueryDelivery.Live or SemanticQueryDelivery.Snapshot))
+        {
+            return "its cardinality or delivery is unsupported";
+        }
+        foreach (var argument in shape.Arguments)
+        {
+            if (argument.Type is null || !TypeExists(context, argument.Type))
+            {
+                return $"argument '{argument.Name}' has an unresolved type";
+            }
+            if (!Enum.IsDefined(argument.Kind))
+            {
+                return $"argument '{argument.Name}' has an unsupported kind";
+            }
+        }
+        var names = shape.Arguments.Select(argument => Identifiers.ToCamelCase(argument.Name)).ToArray();
+        if (names.Contains("performer", StringComparer.Ordinal) || names.Distinct(StringComparer.Ordinal).Count() != names.Length)
+        {
+            return "its argument names collide in generated C#";
+        }
+        var methods = query.Slice.Slice.Queries.Where(other => other.ReadModel == id).Select(context.MemberNames.Query)
+            .Concat(context.PerformedQueries.Where(other => other.Shape?.ReadModel == id && other.Id != query.Id).Select(other => other.Method(model)));
+        return methods.Contains(query.Method(model), StringComparer.Ordinal) ? "its method name collides with another query" : null;
+    }
+
+    static IEnumerable<GeneratedTypeDeclaration> PerformedQueryTypes(SemanticApplicationContext context, IReadOnlyList<LocatedSemanticSlice> slices) =>
+        context.PerformedQueries.Where(query => slices.Any(slice => slice.Slice.Id == query.Slice.Slice.Id))
+            .SelectMany(query => new[]
+            {
+                new GeneratedTypeDeclaration(query.Id, "QueryPerformer", string.Join('.', query.Slice.Path), query.Interface),
+                new GeneratedTypeDeclaration(query.Id, "QueryPerformer", string.Join('.', query.Slice.Path), query.Stub)
+            }).Concat(context.PerformedQueries.Count == 0 ? [] : new[]
+            {
+                new GeneratedTypeDeclaration(context.Application.Id, "Generated", "GeneratedQueries", "Registration")
+            });
+}
