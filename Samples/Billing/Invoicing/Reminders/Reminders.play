module Invoicing

  feature Reminders
    description "Chasing what is owed, without anyone having to remember to"

    slice Automation RemindAboutOverdueInvoices

      reaction InvoiceIssuedReminder
        description "Sends the customer a reminder as soon as an invoice is issued"
        when InvoiceIssued
          invoiceId
          invokes SendInvoiceReminder
            invoiceId = invoiceId

      reaction ExportRequested
        description "Turns the frontend's export request into the work that answers it"
        when InvoiceExportRequested
          requestedBy String
          produces LedgerExportStarted
            for requestedBy
            requestedBy = requestedBy

      event LedgerExportStarted
        requestedBy String

      command SendInvoiceReminder
        invoiceId InvoiceId identifier
        produces InvoiceReminderSent
          for invoiceId
          invoiceId = invoiceId
          sentAt = $context.occurred

      event InvoiceReminderSent
        invoiceId InvoiceId
        sentAt DateTime
