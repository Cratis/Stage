module Ledger

  feature Payments
    description "Money arriving, and what it settles"

    slice StateChange RecordPayment

      command RecordPayment
        paymentId PaymentId identifier
        invoiceId InvoiceId
        amount Money
        authorize IsFinanceStaff
        produces PaymentRecorded
          for paymentId
          paymentId = paymentId
          invoiceId = invoiceId
          amount = amount
          settlesInvoice = false
        handler
          ```csharp
          // The handler is the escape hatch for a decision the declarative form cannot express.
          var command = context.Command;
          var settles = command.Amount.Value >= 1000;
          return new PaymentRecorded(command.PaymentId, command.InvoiceId, command.Amount, settles);
          ```

      event PaymentRecorded
        paymentId PaymentId
        invoiceId InvoiceId
        amount Money
        settlesInvoice Bool

      constraint OnePaymentPerAttempt
        unique event PaymentRecorded

    slice StateView PaymentList

      readmodel PaymentSummary
        paymentId PaymentId
        invoiceId InvoiceId
        amount Money

      projection PaymentSummaryProjection => PaymentSummary
        from PaymentRecorded key paymentId
          invoiceId = invoiceId
          amount = amount

      query PaymentById => PaymentSummary optional
        by paymentId PaymentId

      query LargestPayments => PaymentSummary[]
        performer
          ```csharp
          return readModels.OrderByDescending(_ => _.Amount).Take(5);
          ```

    slice Automation AcknowledgePayment

      event PaymentAcknowledged
        paymentId PaymentId
        amount Money

      reaction AcknowledgeLargePayment
        when PaymentRecorded
          ```csharp
            if (@event.Amount > 1000)
            {
                return [new PaymentAcknowledged(@event.PaymentId, @event.Amount)];
            }
            return [];
            ```
