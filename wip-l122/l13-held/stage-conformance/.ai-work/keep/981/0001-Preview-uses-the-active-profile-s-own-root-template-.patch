+// Copyright (c) Cratis. All rights reserved.
+// Licensed under the MIT license. See LICENSE file in the project root for full license information.
+
+import { TemplateReferenceSource, type UiProfile } from '@cratis/scene.model';
+import { withRootNamedInScene } from '../previewApplication';
+
+const own = (id: string, options?: Record<string, unknown>): UiProfile['root'] => ({ template: { source: TemplateReferenceSource.Own, id }, ...(options ? { options } : {}) });
+const profile = (name: string, root?: UiProfile['root']): UiProfile => ({ name, targetPlatform: 'web', packages: [], ...(root ? { root } : {}) });
+const scene = (profiles: UiProfile[]) => ({
+    layouts: [],
+    screenTemplates: [{ name: 'BackOfficeShell', slots: [{ name: 'content' }] }, { name: 'StorefrontShell', slots: [{ name: 'content' }] }],
+    uiProfiles: profiles,
+});
+const stored = profile('Preview', own('b8b0d8fa-de41-47d0-9285-949075ca964c', { navigationMode: 'static' }));
+const backOffice = profile('BackOffice', own('BackOfficeShell', { navigationMode: 'overlay' }));
+const storefront = profile('Storefront', own('StorefrontShell', { navigationMode: 'overlay', showLogo: true }));
+
+describe('when several profiles have own roots and the active profile is not first', () => {
+    let resolved: UiProfile;
+
+    beforeEach(() => {
+        resolved = withRootNamedInScene(stored, scene([backOffice, storefront]), 'Storefront');
+    });
+
+    it('should use the active profile root rather than the first own root', () => resolved.root!.template.id.should.equal('StorefrontShell'));
+    it('should preserve runtime options over the active compiled root options', () => resolved.root!.options!.should.deep.equal({ navigationMode: 'static', showLogo: true }));
+    it('should leave the stored profile untouched', () => stored.root!.template.id.should.equal('b8b0d8fa-de41-47d0-9285-949075ca964c'));
+});
+
+describe('when the active profile has no compiled profile', () => {
+    it('should keep the stored root rather than use another profile root', () => withRootNamedInScene(stored, scene([backOffice]), 'Storefront').root!.should.equal(stored.root));
+});
+
+describe('when the active compiled profile has no root', () => {
+    it('should keep the stored root rather than use another profile root', () => withRootNamedInScene(stored, scene([backOffice, profile('Storefront')]), 'Storefront').root!.should.equal(stored.root));
+});
+
+describe('when the active compiled root names no template of the document', () => {
+    it('should keep the stored root rather than use another profile root', () => withRootNamedInScene(stored, scene([backOffice, profile('Storefront', own('Elsewhere'))]), 'Storefront').root!.should.equal(stored.root));
+});
+
+describe('when the active compiled root is a blueprint root', () => {
+    const root: UiProfile['root'] = { template: { source: TemplateReferenceSource.Blueprint, id: 'StorefrontShell', blueprint: 'Cratis.Blueprint.Default' } };
+
+    it('should keep the stored root rather than use another profile root', () => withRootNamedInScene(stored, scene([backOffice, profile('Storefront', root)]), 'Storefront').root!.should.equal(stored.root));
+});
diff --git a/Source/Editor/Preview/previewApplication.ts b/Source/Editor/Preview/previewApplication.ts
