module Invoicing

  feature Invoices

    slice StateChange IssueInvoice
      description "Sends a draft invoice to the customer, which is what makes it owed"

      command IssueInvoice
        invoiceId InvoiceId identifier
        issuedOn Date
        reads InvoiceState by invoiceId
        authorize IsBillingClerk
        validate
          require InvoiceState.status == "draft"
            message "Only a draft invoice can be issued"
          require InvoiceState.amount > 0
            message "An invoice for nothing cannot be issued"
        produces InvoiceIssued
          for invoiceId
          invoiceId = invoiceId
          issuedOn = issuedOn
          amount = InvoiceState.amount

      event InvoiceIssued
        invoiceId InvoiceId
        issuedOn Date
        amount Money

      readmodel InvoiceState
        id InvoiceId key
        status InvoiceStatus
        amount Money

      projection InvoiceStateProjection => InvoiceState
        from InvoiceRegistered
          status = "draft"
          amount = amount
        from InvoiceIssued
          status = "issued"
          amount = amount
        remove with InvoiceCancelled

      specification IssuingADraftInvoice
        given caller as BillingClerk
        given InvoiceRegistered
          for "8f14e45f-ceea-467a-9c2b-1b7f2ec2a1c1"
          invoiceId = "8f14e45f-ceea-467a-9c2b-1b7f2ec2a1c1"
          invoiceNumber = "INV-000123"
          customerId = "1f0c2d3e-4b5a-6789-abcd-ef0123456789"
          customerName = "Acme"
          amount = 1500
        when IssueInvoice
          invoiceId = "8f14e45f-ceea-467a-9c2b-1b7f2ec2a1c1"
          issuedOn = "2026-01-15"
        then InvoiceIssued
          invoiceId = "8f14e45f-ceea-467a-9c2b-1b7f2ec2a1c1"
          issuedOn = "2026-01-15"
          amount = 1500

      specification RefusingToIssueAnUnknownInvoice
        given caller as BillingClerk
        when IssueInvoice
          invoiceId = "9f14e45f-ceea-467a-9c2b-1b7f2ec2a1c1"
          issuedOn = "2026-01-15"
        then error "InvoiceState '9f14e45f-ceea-467a-9c2b-1b7f2ec2a1c1' does not exist."
