<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>Cratis.Stage.Specifications</AssemblyName>
        <RootNamespace>Cratis.Stage.Specifications</RootNamespace>
        <IsPackable>true</IsPackable>
        <!-- Type discovery references deprecated structural types from the Stage dependency. -->
        <NoWarn>$(NoWarn);CS0618</NoWarn>
        <!-- Package validation cannot resolve the Chronicle kernel assemblies this package carries, so it stays off. -->
        <EnablePackageValidation>false</EnablePackageValidation>
        <Description>Isolated in-memory Screenplay semantic specification execution.</Description>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="../Stage/Semantics/SemanticApplicationContext.cs" Link="Admission/SemanticApplicationContext.cs" />
        <!-- Compile the render admission predicate from its owning source so run admission cannot drift. -->
        <Compile Include="../Rendering.Cratis/Semantics/Projections/SemanticScopedProjectionSupport.cs" Link="Admission/SemanticScopedProjectionSupport.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/Projections/SemanticFlatProjectionSupport.cs" Link="Admission/SemanticFlatProjectionSupport.cs" />
        <Compile Include="../Rendering.Cratis/Naming/GeneratedPascalCase.cs" Link="Admission/GeneratedPascalCase.cs" />
        <Compile Include="../Rendering.Cratis/Naming/GeneratedTypeNames.cs" Link="Admission/GeneratedTypeNames.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/Projections/ChronicleEventPropertyNameIsSafe.cs" Link="Admission/ChronicleEventPropertyNameIsSafe.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/Projections/ChronicleReadModelPropertyNamesAreSafe.cs" Link="Admission/ChronicleReadModelPropertyNamesAreSafe.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/Projections/ProjectionReferencedEventNamesAreUnique.cs" Link="Admission/ProjectionReferencedEventNamesAreUnique.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/SemanticVersionFeatures.cs" Link="Admission/SemanticVersionFeatures.cs" />
        <ProjectReference Include="../Stage/Stage.csproj" />
        <PackageReference Include="Cratis.Arc.Testing" />
        <PackageReference Include="Cratis.Arc.Chronicle.Testing" />
        <PackageReference Include="Cratis.Chronicle.Testing" />
        <PackageReference Include="Microsoft.Orleans.Reminders" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Cratis.Screenplay.CanonicalCorpus" PrivateAssets="All" />
    </ItemGroup>
</Project>
