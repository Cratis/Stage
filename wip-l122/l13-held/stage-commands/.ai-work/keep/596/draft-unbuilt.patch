+// Copyright (c) Cratis. All rights reserved.
+// Licensed under the MIT license. See LICENSE file in the project root for full license information.
+
+using Cratis.Screenplay.Semantics;
+using Cratis.Specifications;
+using Cratis.Stage.Contracts.Rendering;
+using Cratis.Stage.Rendering.Cratis.for_CratisArtifactRenderPlanner.given;
+using Xunit;
+
+namespace Cratis.Stage.Rendering.Cratis.for_CratisArtifactRenderPlanner;
+
+public class when_rendering_performed_queries : Specification
+{
+    ArtifactRenderPlan _plan = null!;
+    string _source = null!;
+    string _bindings = null!;
+
+    void Because()
+    {
+        var compilation = performed_query_model.Compile();
+        _plan = performed_query_model.Plan(compilation);
+        Assert.True(_plan.Success, string.Join(Environment.NewLine, _plan.Diagnostics));
+        _source = performed_query_model.Text(_plan.Artifacts.Single(artifact => artifact.RelativePath.EndsWith("/Figures.cs", StringComparison.Ordinal)));
+        _bindings = performed_query_model.Text(_plan.Artifacts.Single(artifact => artifact.RelativePath == "src/bindings.ts"));
+    }
+
+    [Fact] void should_render_without_inventing_a_projection() => _source.ShouldNotContain("FromEventAttribute");
+    [Fact] void should_keep_many_results_typed() => _source.ShouldContain("Task<global::System.Collections.Generic.IReadOnlyList<Figures>> GetFigures(");
+    [Fact] void should_keep_a_single_result_nonnullable() => _source.ShouldContain("Task<Figures> Figure(");
+    [Fact] void should_keep_an_optional_result_nullable() => _source.ShouldContain("Task<Figures?> MaybeFigure(");
+    [Fact] void should_keep_live_delivery_and_nullable_concept_arguments() => _source.ShouldContain("IObservable<global::System.Collections.Generic.IReadOnlyList<Figures>> LiveFigures(");
+    [Fact] void should_use_the_declared_concept_argument() => _source.ShouldContain("global::FiguresApp.Common.Region? region");
+    [Fact] void should_fail_loudly_until_an_application_implements_the_hook() => _source.ShouldContain("throw new global::System.NotImplementedException");
+    [Fact] void should_not_emit_mongo_queries_for_an_unprojected_model() => _source.ShouldNotContain("IMongoCollection");
+    [Fact] void should_import_the_generated_proxy_export() => _bindings.ShouldContain("import { GetFigures as");
+    [Fact] void should_register_the_authored_query_name() => _bindings.ShouldContain("\"GetFigures\"");
+    [Fact] void should_not_invent_an_http_route() => _bindings.ShouldNotContain("/api/");
+    [Fact] void should_register_defaults_before_the_unmanaged_service_seam()
+    {
+        var program = performed_query_model.Text(_plan.Artifacts.Single(artifact => artifact.RelativePath == "Program.cs"));
+        Assert.True(program.IndexOf("GeneratedQueries.Registration.Register", StringComparison.Ordinal) < program.IndexOf("ConfigureServices(builder.Services)", StringComparison.Ordinal));
+    }
+    [Fact] void should_keep_the_opaque_reads_outside_the_executor() => performed_query_model.Compile().Value!.Model.Application.Modules.Single().Features.Single().Slices.Single(slice => slice.Kind == SemanticSliceKind.StateView).Queries.ShouldBeEmpty();
+}
