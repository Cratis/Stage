<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Stage.Rendering.Cratis</AssemblyName>
        <RootNamespace>Cratis.Stage.Rendering.Cratis</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <TargetFramework></TargetFramework>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <Description>The Cratis Stage Cratis renderer — generates a Cratis Arc + Chronicle vertical-slice application from a compiled Screenplay application.</Description>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Cratis.Screenplay" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" />
        <PackageReference Include="System.Security.Cryptography.Xml" />
    </ItemGroup>
    <!--
        Specs compile the rendered output in memory against the real Cratis assemblies — asserting on generated
        strings is what let a whole class of non-compiling output ship unnoticed. These are private assets: the
        renderer itself does not depend on Cratis at runtime, only its specs do.

        Named individually rather than through the Cratis meta-package: that package contributes
        GlobalUsings.cs through its Cratis.props, so every consumer of this one silently gains 28 global
        usings and the type collisions that come with them. These carry no build assets. Arc.Chronicle and
        Arc.Swagger are here only so the spec compilation can model the ambient namespaces a real Cratis
        application has, not because rendered code names anything in them; MongoDB.Driver is, because a
        rendered read model exposes its collection query as IMongoCollection&lt;T&gt;. The Testing packages
        are what a rendered specification compiles against - CommandScenario, ReadModelScenario and the appended-event
        assertions. Cratis.Chronicle.Testing is named explicitly so the compile sees the pinned client, not the older one
        Arc.Chronicle.Testing brings transitively.

        Arc.MongoDB is the one the scaffolded project template also references, and it is what puts Observe and
        ObserveById on IMongoCollection&lt;T&gt; - a rendered observable query calls them and nothing else does,
        so without it here the compile spec would pass on output the rendered application cannot build.
    -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <!--
            Analyzers are excluded deliberately: Cratis' type-discovery source generator would bake a registration
            into this assembly that binds the Cratis runtime at startup, which the renderer — a text generator —
            has no reason to do.
        -->
        <PackageReference Include="Cratis.Arc" ExcludeAssets="analyzers" />
        <PackageReference Include="Cratis.Arc.Chronicle" ExcludeAssets="analyzers" />
        <PackageReference Include="Cratis.Arc.Chronicle.Testing" ExcludeAssets="analyzers" />
        <PackageReference Include="Cratis.Arc.MongoDB" ExcludeAssets="analyzers" />
        <PackageReference Include="Cratis.Arc.Swagger" ExcludeAssets="analyzers" />
        <PackageReference Include="Cratis.Arc.Testing" ExcludeAssets="analyzers" />
        <PackageReference Include="Cratis.Chronicle" GeneratePathProperty="true" ExcludeAssets="analyzers" />
        <PackageReference Include="Cratis.Chronicle.Testing" ExcludeAssets="analyzers" />
        <PackageReference Include="MongoDB.Driver" />
        <!--
            The emitted host references Microsoft.Identity.Web for its optional Entra ID sign-in, so the in-process
            compile specs must see it too. TestHost runs the emitted authentication code in a real pipeline.
        -->
        <PackageReference Include="Microsoft.Identity.Web" ExcludeAssets="analyzers" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" />
        <!--
            The frozen RegisterProject conformance corpus - the planner fixture loads its source and identity
            catalog through the real serializers instead of copying strings or repository-relative files.
            Debug-only and PrivateAssets="All": specs are stripped from Release (Source/Directory.Build.targets),
            so this dependency never needs to appear in the packed renderer's public dependency surface.
        -->
        <PackageReference Include="Cratis.Screenplay.CanonicalCorpus" PrivateAssets="All" />
    </ItemGroup>
    <ItemGroup>
        <!-- Both reducer binding and inline handler admission use Roslyn at runtime;
             packed consumers must receive its runtime assemblies transitively. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="All" />
        <!-- Embed the audited BCL reference assemblies: rolling SDKs and runtime-only hosts
             need not install this exact patch of the SDK pack. Never bind against a newer pack. -->
        <PackageReference Include="Microsoft.NETCore.App.Ref" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    </ItemGroup>
    <!--
        Generation binding uses only an embedded metadata image, never a renderer runtime dependency. A direct reference
        overrides the transitive one, so Debug keeps Fundamentals' compile and runtime assets for the specs (which compile
        rendered code against the real Cratis assemblies), while Release takes nothing but the package path.
    -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Cratis.Fundamentals" GeneratePathProperty="true" ExcludeAssets="analyzers" PrivateAssets="all" />
        <PackageReference Include="System.Reactive" GeneratePathProperty="true" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
        <PackageReference Include="Cratis.Fundamentals" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
        <PackageReference Include="System.Reactive" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
        <!-- Release takes only the package path of Chronicle, embedded below for reaction body admission. -->
        <PackageReference Include="Cratis.Chronicle" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <!-- The specs compile the state machines and workflows Stage renders against the real Cratis.Choreography assemblies. -->
        <PackageReference Include="Cratis.Choreography" ExcludeAssets="analyzers" PrivateAssets="all" />
        <PackageReference Include="Cratis.Choreography.Chronicle" ExcludeAssets="analyzers" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <!-- Frozen Screenplay v4.41.0 typed-context vectors: every member and nullable type is checked by specs. -->
        <EmbeddedResource Include="for_SemanticTypedContextRenderer/Vectors/*.json" />
        <!-- Screenplay v4.114.0 portable stream-id codec vectors. -->
        <EmbeddedResource Include="CodeGeneration/for_StreamIdsRendering/Vectors/*.json" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Cratis.Stage.Conformance.Specs</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup>
        <!-- What the Stage frontend's core, PrimeReact and default blueprint declare, generated from their manifests by
             Frontend/src/shippedPackages.spec.ts, which fails when it is stale: the catalog a ui profile is resolved against
             must be the one the frontend renders with. -->
        <EmbeddedResource Include="Shipped/ShippedPackages.json" LogicalName="Cratis.Stage.Rendering.Cratis.Shipped.ShippedPackages.json" />
    </ItemGroup>
    <ItemGroup>
        <!-- The framework names in scope in a generated project, read by the C# import resolver. Generated from the
             scaffold's restored compile assets by for_FrameworkNameCatalog; checked in so its changes show in review. -->
        <EmbeddedResource Include="Naming/Imports/FrameworkNames.catalog" LogicalName="Cratis.Stage.Rendering.Cratis.Naming.Imports.FrameworkNames.catalog" />
    </ItemGroup>
    <ItemGroup>
        <!-- The source of the files an application rendered with authentication or onboarding gets. -->
        <EmbeddedResource Include="Realization/Templates/*.txt" LogicalName="Cratis.Stage.Rendering.Cratis.Realization.%(Filename)%(Extension)" WithCulture="false" />
    </ItemGroup>
    <ItemGroup>
        <!-- One tenant translation implementation serves the Stage runtime and generated providers. -->
        <EmbeddedResource Include="../Stage/Runtime/PortableTenantValues.cs" LogicalName="PortableTenantValues.cs" />
        <EmbeddedResource Include="../Stage/Runtime/AmbiguousTenant.cs" LogicalName="AmbiguousTenant.cs" />
    </ItemGroup>
    <PropertyGroup>
        <!-- The SDK's implicit targeting-pack download of the same package (another version) is intended to coexist. -->
        <NoWarn>$(NoWarn);NU1505</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <!-- The net11.0 reference pack is downloaded from NuGet (not referenced: one project cannot reference two versions
             of one package) so the embedded set never depends on an SDK install. A missing pack fails restore. -->
        <PackageDownload Include="Microsoft.NETCore.App.Ref" Version="[$(PureTransitionReferencePackVersion11)]" />
    </ItemGroup>
    <ItemGroup>
        <!-- Embed the pinned 10.0.12 reference pack; the resource version must match
             PureTransitionAdmission.ReferencePackVersion and Directory.Packages.props.
             WithCulture prevents System.IO.dll from becoming a spurious IO satellite assembly. -->
        <EmbeddedResource Include="$(PkgMicrosoft_NETCore_App_Ref)/ref/net10.0/*.dll" LogicalName="PureTransitionReferences.$(PureTransitionReferencePackVersion).%(Filename)%(Extension)" WithCulture="false" />
        <EmbeddedResource Include="$(PkgCratis_Fundamentals)/lib/net10.0/Cratis.Fundamentals.dll" LogicalName="GenerationReferences.Cratis.Fundamentals.dll" WithCulture="false" />
        <EmbeddedResource Include="$(PkgCratis_Chronicle)/lib/net10.0/Cratis.Chronicle.dll" LogicalName="GenerationReferences.Cratis.Chronicle.dll" WithCulture="false" />
        <EmbeddedResource Include="$(PkgSystem_Reactive)/ref/net8.0/System.Reactive.dll" LogicalName="GenerationReferences.System.Reactive.dll" WithCulture="false" />
    </ItemGroup>
    <!-- The version 4 (net11.0) profile analyses against the 11.0.0 pack, embedded with its own resource version so
         version 3 stays bound to net10.0. Items are created at target time so NuGetPackageRoot is always defined;
         an absent pack fails the build rather than silently dropping the net11 references. -->
    <Target Name="EmbedNet11ReferencePack" BeforeTargets="AssignTargetPaths">
        <PropertyGroup>
            <Net11ReferencePackDirectory>$(NuGetPackageRoot)microsoft.netcore.app.ref/$(PureTransitionReferencePackVersion11)/ref/net11.0/</Net11ReferencePackDirectory>
        </PropertyGroup>
        <ItemGroup>
            <Net11ReferenceAssembly Include="$(Net11ReferencePackDirectory)*.dll" />
        </ItemGroup>
        <Error Condition="'@(Net11ReferenceAssembly)' == ''" Text="Microsoft.NETCore.App.Ref $(PureTransitionReferencePackVersion11) reference assemblies not found in $(Net11ReferencePackDirectory); restore the package." />
        <ItemGroup>
            <EmbeddedResource Include="@(Net11ReferenceAssembly)" LogicalName="PureTransitionReferences.$(PureTransitionReferencePackVersion11).%(Filename)%(Extension)" Type="Non-Resx" WithCulture="false" />
        </ItemGroup>
    </Target>
    <!-- The SDK already loads these analyzers from its framework pack; loading the NuGet
         copy a second time makes the regex generator emit duplicate partial members. -->
    <Target Name="RemoveDuplicateReferencePackAnalyzers" BeforeTargets="CoreCompile">
        <ItemGroup>
            <Analyzer Remove="$(PkgMicrosoft_NETCore_App_Ref)/analyzers/dotnet/cs/*.dll" />
            <!-- Fundamentals is metadata-only here; do not run its type-discovery generator. -->
            <Analyzer Remove="$(PkgCratis_Fundamentals)/analyzers/dotnet/cs/*.dll" />
        </ItemGroup>
    </Target>
    <ItemGroup>
        <Compile Include="../Stage/Semantics/SemanticListCreation.cs" Link="Semantics/SemanticListCreation.cs" />
        <Compile Include="../Stage/Semantics/SemanticProjectionObservation.cs" Link="Semantics/SemanticProjectionObservation.cs" />
        <ProjectReference Include="../Contracts/Contracts.csproj" />
    </ItemGroup>
    <!-- The emitted NuGet pins come from the same evaluated CPM items as Stage's build, in both configurations. -->
    <Target Name="GenerateScaffoldPackageVersions" BeforeTargets="CoreCompile">
        <ItemGroup>
            <_ScaffoldPackage Include="Cratis.Screenplay" Constant="Screenplay" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Screenplay')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis.Screenplay.Matching" Constant="ScreenplayMatching" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Screenplay.Matching')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis" Constant="Cratis" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis.Arc.MongoDB" Constant="ArcMongoDB" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Arc.MongoDB')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis.Arc.Neo4j" Constant="ArcNeo4j" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Arc.Neo4j')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis.Arc.Chronicle.Testing" Constant="ArcChronicleTesting" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Arc.Chronicle.Testing')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis.Specifications" Constant="Specifications" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Specifications')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis.Specifications.XUnit" Constant="SpecificationsXUnit" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Specifications.XUnit')->Metadata('Version'))" />
            <_ScaffoldPackage Include="System.Security.Cryptography.Pkcs" Constant="CryptographyPkcs" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'System.Security.Cryptography.Pkcs')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Microsoft.Identity.Web" Constant="IdentityWeb" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.Identity.Web')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Microsoft.Extensions.Telemetry.Abstractions" Constant="TelemetryAbstractions" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.Extensions.Telemetry.Abstractions')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Microsoft.NET.Test.Sdk" Constant="TestSdk" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.NET.Test.Sdk')->Metadata('Version'))" />
            <_ScaffoldPackage Include="NSubstitute" Constant="NSubstitute" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'NSubstitute')->Metadata('Version'))" />
            <_ScaffoldPackage Include="xunit" Constant="Xunit" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'xunit')->Metadata('Version'))" />
            <_ScaffoldPackage Include="xunit.runner.visualstudio" Constant="XunitRunner" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'xunit.runner.visualstudio')->Metadata('Version'))" />
            <_ScaffoldPackage Include="@cratis/stage.runtime" Constant="StageRuntime" PinVersion="$(Version)" />
            <_ScaffoldPackage Include="Aspire.Hosting.AppHost" Constant="AspireAppHost" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Aspire.Hosting.AppHost')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis.Ante.Contracts" Constant="AnteContracts" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Ante.Contracts')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis.Showrunner.Herald" Constant="Herald" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Showrunner.Herald')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis.Showrunner.BoxOffice" Constant="BoxOffice" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Showrunner.BoxOffice')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis.Chronicle.ForAnte" Constant="AnteChronicle" PinVersion="$(AnteContractsChronicleVersion)" />
            <_ScaffoldPackage Include="Cratis.Choreography" Constant="Choreography" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Choreography')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis.Choreography.Chronicle" Constant="ChoreographyChronicle" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Choreography.Chronicle')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis.Arc.Availability" Constant="ArcAvailability" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Arc.Availability')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis.Showrunner.GuestList" Constant="GuestList" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Showrunner.GuestList')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis.Showrunner.GuestList.Availability" Constant="GuestListAvailability" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Showrunner.GuestList.Availability')->Metadata('Version'))" />
            <_ScaffoldPackage Include="Cratis.Chronicle" Constant="Chronicle" PinVersion="@(PackageVersion->WithMetadataValue('Identity', 'Cratis.Chronicle')->Metadata('Version'))" />
        </ItemGroup>
        <Error Code="STAGE-MISSING-SCAFFOLD-PIN" Condition="'%(_ScaffoldPackage.PinVersion)' == ''"
               Text="Required scaffold pin '%(_ScaffoldPackage.Identity)' is missing. Check Directory.Packages.props, or the Stage Version property for @cratis/stage.runtime." />
        <WriteLinesToFile File="$(IntermediateOutputPath)ScaffoldPackageVersions.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                          Lines="// &lt;auto-generated /&gt;;namespace Cratis.Stage.Rendering.Cratis.Scaffolding%3B;internal static class ScaffoldPackageVersions {;@(_ScaffoldPackage->'internal const string %(Constant) = &quot;%(PinVersion)&quot;%3B');}" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)ScaffoldPackageVersions.g.cs" />
            <FileWrites Include="$(IntermediateOutputPath)ScaffoldPackageVersions.g.cs" />
        </ItemGroup>
    </Target>
</Project>
