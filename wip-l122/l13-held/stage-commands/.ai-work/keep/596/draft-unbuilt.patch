+// Copyright (c) Cratis. All rights reserved.
+// Licensed under the MIT license. See LICENSE file in the project root for full license information.
+
+using Cratis.Screenplay.Semantics;
+using Cratis.Stage.Rendering.Cratis.Naming;
+
+namespace Cratis.Stage.Rendering.Cratis.Semantics;
+
+/// <summary>
+/// Locates an opaque query's rendering contract without adding it to the executable query plan.
+/// </summary>
+/// <param name="Requirement">The compiler's implementation requirement.</param>
+/// <param name="Slice">The declaring slice.</param>
+internal sealed record SemanticPerformedQuery(SemanticImplementationRequirement Requirement, LocatedSemanticSlice Slice)
+{
+    internal SemanticId Id => Requirement.Source?.SemanticId ?? SemanticId.Create(Requirement.Owner);
+
+    internal string Name => Requirement.Member;
+
+    internal SemanticPerformedQueryShape? Shape => Requirement.QueryShape;
+
+    internal string Method(SemanticReadModel model) => GeneratedPascalCase.QueryMethod(model.Name, model.Properties.Select(property => property.Name), Name);
+
+    internal string Interface => $"I{Identifiers.ToPascalCase(Name)}Performer";
+
+    internal string Stub => $"{Identifiers.ToPascalCase(Name)}Performer";
+
+    internal static IReadOnlyList<SemanticPerformedQuery> Locate(
+        IEnumerable<SemanticImplementationRequirement> requirements,
+        IEnumerable<LocatedSemanticSlice> slices) =>
+        [.. requirements.Where(requirement => requirement.Role == SemanticImplementationRole.QueryPerformer)
+            .Select(requirement => new SemanticPerformedQuery(requirement, slices.Single(slice => Owns(requirement, slice))))];
+
+    static bool Owns(SemanticImplementationRequirement requirement, LocatedSemanticSlice slice) =>
+        requirement.Owner.Parts.Where(part => part.Kind is SemanticAddressPartKind.Module or SemanticAddressPartKind.Feature or SemanticAddressPartKind.Slice)
+            .Select(part => part.Key).SequenceEqual(new[] { slice.Module.Name }.Concat(slice.FeaturePath.Select(feature => feature.Name)).Append(slice.Slice.Name));
+}
