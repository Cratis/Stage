<Project>
    <UsingTask TaskName="Cratis.Stage.Rendering.Cratis.ReferencePacks.ReferencePackVerifier"
               TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
        <Task>
            <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)ReferencePackVerifier.cs" />
        </Task>
    </UsingTask>
    <PropertyGroup>
        <ReferencePackManifestDirectory>$(MSBuildThisFileDirectory)</ReferencePackManifestDirectory>
    </PropertyGroup>
    <ItemGroup>
        <!-- This is build tooling, not renderer runtime code. Specs compile this same source. -->
        <Compile Remove="ReferencePacks/ReferencePackVerifier.cs" />
    </ItemGroup>
    <!-- No Inputs/Outputs: recheck even on incremental builds, before any resources are assigned. -->
    <Target Name="VerifyEmbeddedReferencePacks" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolvePackageAssets">
        <ReferencePackVerifier PackDirectory="$(PkgMicrosoft_NETCore_App_Ref)/ref/net10.0"
                               ManifestPath="$(ReferencePackManifestDirectory)$(PureTransitionReferencePackVersion)-net10.0.sha256" />
        <ReferencePackVerifier PackDirectory="$(NuGetPackageRoot)microsoft.netcore.app.ref/$(PureTransitionReferencePackVersion11)/ref/net11.0"
                               ManifestPath="$(ReferencePackManifestDirectory)$(PureTransitionReferencePackVersion11)-net11.0.sha256" />
    </Target>
</Project>
