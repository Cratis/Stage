<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Stage.Contracts</AssemblyName>
        <RootNamespace>Cratis.Stage.Contracts</RootNamespace>
        <IsPackable>true</IsPackable>
        <Description>The Cratis Stage contract — the event model intermediate format, specification run results and their serialization.</Description>
    </PropertyGroup>
    <ItemGroup>
        <!-- JSON Schema describing the event model intermediate format, embedded so it ships with the assembly. -->
        <EmbeddedResource Include="EventModel.schema.json" />
    </ItemGroup>
    <ItemGroup>
        <!-- The Screenplay language compiler — the event model input is authored as .play source. -->
        <PackageReference Include="Cratis.Screenplay" />
        <!-- The Scene object model — screens/layouts/forms translate into these types. -->
        <PackageReference Include="Cratis.Scene.Model" />
        <!--
            Scene's resolution engines — package/component resolution, theme compatibility, screen template
            placement, size classes and arrangement evaluation. Referenced so a render plan drives them
            unmodified rather than Stage reimplementing any of it (Cratis/Stage#39).
        -->
        <PackageReference Include="Cratis.Scene.Engine" />
    </ItemGroup>
</Project>
