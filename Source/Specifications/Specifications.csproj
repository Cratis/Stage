<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>Cratis.Stage.Specifications</AssemblyName>
        <RootNamespace>Cratis.Stage.Specifications</RootNamespace>
        <IsPackable>true</IsPackable>
        <!-- Type discovery references deprecated structural types from the Stage dependency. -->
        <NoWarn>$(NoWarn);CS0618</NoWarn>
        <!-- This new package has no published 3.15.1 baseline to compare against. -->
        <EnablePackageValidation>false</EnablePackageValidation>
        <Description>Isolated in-memory Screenplay semantic specification execution.</Description>
    </PropertyGroup>
    <ItemGroup>
        <!-- Compile the render admission predicate from its owning source so run admission cannot drift. -->
        <Compile Include="../Rendering.Cratis/Semantics/Projections/SemanticScopedProjectionSupport.cs" Link="Admission/SemanticScopedProjectionSupport.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/Projections/SemanticFlatProjectionSupport.cs" Link="Admission/SemanticFlatProjectionSupport.cs" />
        <ProjectReference Include="../Stage/Stage.csproj" />
        <PackageReference Include="Cratis.Arc.Testing" />
        <PackageReference Include="Cratis.Arc.Chronicle.Testing" />
        <PackageReference Include="Cratis.Chronicle.Testing" />
        <PackageReference Include="Microsoft.Orleans.Reminders" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Cratis.Screenplay.CanonicalCorpus" PrivateAssets="All" />
    </ItemGroup>
</Project>
