+        var plan = performed_query_model.Plan(performed_query_model.Compile());
+        Assert.True(plan.Success, string.Join(Environment.NewLine, plan.Diagnostics));
+        var files = plan.Artifacts.Where(artifact => artifact.RelativePath.EndsWith(".cs", StringComparison.Ordinal) && artifact.RelativePath != "Program.cs")
+            .Select(artifact => new RenderedFile(artifact.RelativePath, performed_query_model.Text(artifact)))
+            .Append(new("Customizations/FiguresAnswer.cs", """
+                namespace FiguresApp.Billing.Invoicing.Figures;
+                public sealed class FiguresAnswer : IGetFiguresPerformer
+                {
+                    public System.Threading.Tasks.Task<System.Collections.Generic.IReadOnlyList<Figures>> Perform() =>
+                        System.Threading.Tasks.Task.FromResult<System.Collections.Generic.IReadOnlyList<Figures>>([new(17)]);
+                }
+                """)).ToArray();
+        _warnings = [.. RenderedOutput.Warnings(files)];
+        _assembly = RenderedOutput.Load(files);
+        _hook = _assembly.GetTypes().Single(type => type.Name == "IGetFiguresPerformer");
+        var services = new ServiceCollection();
+        _assembly.GetType("FiguresApp.GeneratedQueries.Registration")!.GetMethod("Register")!.Invoke(null, [services]);
+        services.AddScoped(_hook, _assembly.GetTypes().Single(type => type.Name == "FiguresAnswer"));
+        _services = services.BuildServiceProvider();
+        var method = _assembly.GetTypes().Single(type => type.Name == "Figures").GetMethod("GetFigures")!;
+        var pending = (Task)method.Invoke(null, [_services.GetRequiredService(_hook)])!;
+        await pending;
+        _answer = pending.GetType().GetProperty("Result")!.GetValue(pending)!;
+    }
+
+    void Destroy() => _services?.Dispose();
+
+    [Fact] void should_compile_without_warnings() => _warnings.ShouldBeEmpty();
+    [Fact] void should_forward_the_query_to_the_replacement_hook()
+    {
+        var row = Assert.Single(((System.Collections.IEnumerable)_answer).Cast<object>());
+        Convert.ToInt64(row.GetType().GetProperty("Total")!.GetValue(row)).ShouldEqual(17L);
+    }
+    [Fact] void should_keep_an_unimplemented_default_fail_loud()
+    {
+        var stub = Activator.CreateInstance(_assembly.GetTypes().Single(type => type.Name == "FigurePerformer"));
+        var method = stub!.GetType().GetMethod("Perform")!;
+        var error = Assert.Throws<TargetInvocationException>(() => method.Invoke(stub, ["one"]));
+        Assert.IsType<NotImplementedException>(error.InnerException);
+    }
+}
+#endif
