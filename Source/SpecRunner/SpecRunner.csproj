<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <OutputType>Exe</OutputType>
        <XunitAutoGeneratedEntryPoint Condition="'$(Configuration)' == 'Debug'">false</XunitAutoGeneratedEntryPoint>
        <AssemblyName>Cratis.Stage.SpecRunner</AssemblyName>
        <RootNamespace>Cratis.Stage.SpecRunner</RootNamespace>
        <!-- Type discovery emits references to deprecated structural types while compatibility remains. -->
        <NoWarn>$(NoWarn);CS0618</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Stage/Stage.csproj" />
        <ProjectReference Include="../Specifications/Specifications.csproj" />
    </ItemGroup>
</Project>
