@@ -0,0 +1,91 @@
+// Copyright (c) Cratis. All rights reserved.
+// Licensed under the MIT license. See LICENSE file in the project root for full license information.
+
+using Cratis.Screenplay.Semantics;
+using Cratis.Stage.Contracts.Rendering;
+using Cratis.Stage.Rendering.Cratis.CodeGeneration;
+using Cratis.Stage.Rendering.Cratis.Naming;
+
+namespace Cratis.Stage.Rendering.Cratis.Semantics;
+
+/// <summary>Renders typed application hooks for reads Stage cannot execute.</summary>
+internal static class SemanticPerformedQueryRenderer
+{
+    internal static void RenderQuery(CSharpCodeBuilder builder, SemanticPerformedQuery query, SemanticReadModel model, SemanticTypeSystem types)
+    {
+        var arguments = query.Shape!.Arguments;
+        var parameters = new[] { $"[global::Microsoft.AspNetCore.Mvc.FromServicesAttribute] {query.Interface} performer" }
+            .Concat(arguments.Select(argument => $"{ArgumentType(argument, types)} {Parameter(argument)}"));
+        builder.BlankLine().Summary($"Answers {query.Name} through the application's performer.")
+            .Line("/// <param name=\"performer\">The application query implementation.</param>");
+        foreach (var argument in arguments)
+        {
+            builder.Line($"/// <param name=\"{Parameter(argument).TrimStart('@')}\">The query argument.</param>");
+        }
+        builder.Line("/// <returns>The performer's result.</returns>")
+            .Attribute($"global::Cratis.Arc.Queries.ModelBound.QueryAttribute({CSharpCodeBuilder.StringLiteral(query.Name)})")
+            .Attribute("global::Cratis.Arc.Authorization.AuthorizeAttribute")
+            .Line($"public static {ReturnType(query, model)} {query.Method(model)}({string.Join(", ", parameters)}) =>")
+            .Line($"    performer.Perform({string.Join(", ", arguments.Select(Parameter))});");
+    }
+
+    internal static void RenderHooks(CSharpCodeBuilder builder, LocatedSemanticSlice located, SemanticApplicationContext context)
+    {
+        var types = new SemanticTypeSystem(context);
+        foreach (var query in context.PerformedQueries.Where(query => query.Slice.Slice.Id == located.Slice.Id))
+        {
+            var model = context.ReadModels[query.Shape!.ReadModel!.Value];
+            var signature = $"{ReturnType(query, model)} Perform({string.Join(", ", query.Shape.Arguments.Select(argument => $"{ArgumentType(argument, types)} {Parameter(argument)}"))})";
+            builder.BlankLine().Summary($"Answers the opaque {query.Name} query. Implement in Customizations/.")
+                .OpenBlock($"public interface {query.Interface}")
+                .Summary("Answers the caller's query.");
+            foreach (var argument in query.Shape.Arguments)
+            {
+                builder.Line($"/// <param name=\"{Parameter(argument).TrimStart('@')}\">The query argument.</param>");
+            }
+            builder.Line("/// <returns>The performer's result.</returns>").Line($"{signature};").EndBlock();
+            builder.BlankLine().Summary($"Unimplemented placeholder for {query.Name}; replace through ConfigureServices.")
+                .OpenBlock($"public sealed class {query.Stub} : {query.Interface}")
+                .Line("/// <inheritdoc/>")
+                .Line($"public {signature} => throw new global::System.NotImplementedException({CSharpCodeBuilder.StringLiteral($"Supply {query.Interface} in Customizations/Program.cs to answer '{query.Name}'.")});")
+                .EndBlock();
+        }
+    }
+
+    internal static PlannedArtifact Registration(SemanticApplicationContext context)
+    {
+        var builder = new CSharpCodeBuilder().Using("Microsoft.Extensions.DependencyInjection.Extensions")
+            .Namespace($"{context.RootNamespace}.GeneratedQueries")
+            .Summary("Registers generated query placeholders before application customizations.")
+            .OpenBlock("public static class Registration")
+            .Summary("Registers a replaceable placeholder for every opaque query.")
+            .Line("/// <param name=\"services\">The application's services.</param>")
+            .OpenBlock("public static void Register(global::Microsoft.Extensions.DependencyInjection.IServiceCollection services)");
+        foreach (var query in context.PerformedQueries)
+        {
+            var ns = $"global::{SliceNaming.Namespace(context.RootNamespace, query.Slice.Path)}";
+            builder.Line($"services.TryAddScoped<{ns}.{query.Interface}, {ns}.{query.Stub}>();");
+        }
+        builder.EndBlock().EndBlock();
+        return PlannedArtifact.CreateText("GeneratedQueryRegistration.cs", builder.ToString(), [.. context.PerformedQueries.Select(query => query.Id)]);
+    }
+
+    static string ReturnType(SemanticPerformedQuery query, SemanticReadModel model)
+    {
+        var type = Identifiers.ToPascalCase(model.Name);
+        var result = query.Shape!.Cardinality switch
+        {
+            SemanticQueryCardinality.Many => $"global::System.Collections.Generic.IReadOnlyList<{type}>",
+            SemanticQueryCardinality.ZeroOrOne => $"{type}?",
+            _ => type
+        };
+        return query.Shape.Delivery == SemanticQueryDelivery.Live
+            ? $"global::System.IObservable<{result}>"
+            : $"global::System.Threading.Tasks.Task<{result}>";
+    }
+
+    static string ArgumentType(SemanticPerformedQueryArgument argument, SemanticTypeSystem types) =>
+        types.Type(argument.Type! with { IsOptional = argument.IsOptional || argument.Type!.IsOptional });
+
+    static string Parameter(SemanticPerformedQueryArgument argument) => Identifiers.EscapeKeyword(Identifiers.ToCamelCase(argument.Name));
+}
