<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <OutputType>Library</OutputType>
        <AssemblyName>Cratis.Stage</AssemblyName>
        <RootNamespace>Cratis.Stage</RootNamespace>
        <IsPackable>true</IsPackable>
        <CratisEmbeddedScreenplayEnabled>false</CratisEmbeddedScreenplayEnabled>
        <!-- Type discovery emits references to the deprecated structural types; retain them through the next major. -->
        <NoWarn>$(NoWarn);CS0618</NoWarn>
        <Description>The Cratis Stage engine — materializes an authored event model into a live Cratis application at runtime.</Description>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Cratis.Stage.Host</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cratis" />
        <PackageReference Include="Cratis.Fundamentals" />
        <PackageReference Include="Cratis.Arc.MongoDB" />
        <!--
            The Chronicle client packages are referenced directly, not left to arrive transitively through the Cratis
            meta-package: central package management only pins direct references, so without these the client ships at
            whatever version that package was built against while Contracts follows the pin - the mismatch that crashed
            the 3.6.0 image at boot. Keep them at the version Directory.Packages.props pins.
        -->
        <PackageReference Include="Cratis.Chronicle" />
        <PackageReference Include="Cratis.Chronicle.AspNetCore" />
        <PackageReference Include="Cratis.Chronicle.Contracts" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Contracts/Contracts.csproj" />
        <!-- Share the executor's value-shape rule and renderer predicates without referencing the Testing executor. -->
        <Compile Include="../Specifications/Commands/SemanticValueShapeAdmission.cs" Link="Semantics/Admission/SemanticValueShapeAdmission.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/Projections/SemanticScopedProjectionSupport.cs" Link="Semantics/Admission/SemanticScopedProjectionSupport.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/Projections/SemanticProjectionProducts.cs" Link="Semantics/Admission/SemanticProjectionProducts.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/Projections/SemanticFlatProjectionSupport.cs" Link="Semantics/Admission/SemanticFlatProjectionSupport.cs" />
        <Compile Include="../Rendering.Cratis/Naming/GeneratedPascalCase.cs" Link="Semantics/Admission/GeneratedPascalCase.cs" />
        <Compile Include="../Rendering.Cratis/Naming/GeneratedTypeNames.cs" Link="Semantics/Admission/GeneratedTypeNames.cs" />
        <Compile Include="../Rendering.Cratis/Naming/GeneratedTypeDeclaration.cs" Link="Semantics/Admission/GeneratedTypeDeclaration.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/Projections/ChronicleEventPropertyNameIsSafe.cs" Link="Semantics/Admission/ChronicleEventPropertyNameIsSafe.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/Projections/ChronicleReadModelPropertyNamesAreSafe.cs" Link="Semantics/Admission/ChronicleReadModelPropertyNamesAreSafe.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/Projections/ProjectionReferencedEventNamesAreUnique.cs" Link="Semantics/Admission/ProjectionReferencedEventNamesAreUnique.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/SemanticDestinations.cs" Link="Semantics/Admission/SemanticDestinations.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/SemanticReactionProductions.cs" Link="Semantics/Admission/SemanticReactionProductions.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/SemanticTranslationSupport.cs" Link="Semantics/Admission/SemanticTranslationSupport.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/SemanticCaptureIdentitySupport.cs" Link="Semantics/Admission/SemanticCaptureIdentitySupport.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/SemanticVersionFeatures.cs" Link="Semantics/Admission/SemanticVersionFeatures.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/Policies/SemanticAnonymousAccess.cs" Link="Semantics/Admission/SemanticAnonymousAccess.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/EsmVersionRange.cs" Link="Semantics/Admission/EsmVersionRange.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/EsmVersionStanding.cs" Link="Semantics/Admission/EsmVersionStanding.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/EsmSupport.cs" Link="Semantics/Admission/EsmSupport.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/CratisEsmSupport.cs" Link="Semantics/Admission/CratisEsmSupport.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/SemanticSurfaceLedger.cs" Link="Semantics/Admission/SemanticSurfaceLedger.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/SemanticUnknownMember.cs" Link="Semantics/Admission/SemanticUnknownMember.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/SemanticUnknownMemberScope.cs" Link="Semantics/Admission/SemanticUnknownMemberScope.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/SemanticUnknownMembers.cs" Link="Semantics/Admission/SemanticUnknownMembers.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/EsmSupportStanding.cs" Link="Semantics/Admission/EsmSupportStanding.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/EsmRangeSurface.cs" Link="Semantics/Admission/EsmRangeSurface.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/SemanticSpecificationClock.cs" Link="Semantics/Admission/SemanticSpecificationClock.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/SemanticGenerationShapes.cs" Link="Semantics/Admission/SemanticGenerationShapes.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/SemanticPatternShape.cs" Link="Semantics/Admission/SemanticPatternShape.cs" />
        <Compile Include="../Rendering.Cratis/Semantics/SemanticProductionComparison.cs" Link="Semantics/Admission/SemanticProductionComparison.cs" />
    </ItemGroup>
</Project>
