+using Cratis.Specifications;
+using Cratis.Stage.Contracts.Rendering;
+using Cratis.Stage.Rendering.Cratis.for_CratisArtifactRenderPlanner.given;
+using Xunit;
+
+namespace Cratis.Stage.Rendering.Cratis.for_CratisArtifactRenderPlanner;
+
+public class when_preserving_projectionless_query_admission : Specification
+{
+    ArtifactRenderPlan _noDescriptor = null!;
+    ArtifactRenderPlan _declarativeQuery = null!;
+    string _before = null!;
+    string _after = null!;
+
+    void Because()
+    {
+        var compilation = performed_query_model.Compile();
+        _noDescriptor = performed_query_model.Plan(compilation, []);
+        _declarativeQuery = performed_query_model.Plan(performed_query_model.Compile(performed_query_model.Source + "\n      query ByTotal => Figures?\n        by total Int\n"));
+        var baseline = performed_query_model.Plan(performed_query_model.Compile(invoice_model.Source("String", invoice_model.TextSource, invoice_model.OtherTextSource)));
+        var added = performed_query_model.Plan(performed_query_model.Compile(performed_query_model.WithCommand));
+        Assert.True(baseline.Success, string.Join(Environment.NewLine, baseline.Diagnostics));
+        Assert.True(added.Success, string.Join(Environment.NewLine, added.Diagnostics));
+        _before = performed_query_model.Text(baseline.Artifacts.Single(artifact => artifact.RelativePath.EndsWith("/Issue.cs", StringComparison.Ordinal)));
+        _after = performed_query_model.Text(added.Artifacts.Single(artifact => artifact.RelativePath.EndsWith("/Issue.cs", StringComparison.Ordinal)));
+    }
+
+    [Fact] void should_still_refuse_an_unbacked_model_without_a_performer_descriptor() => _noDescriptor.Diagnostics.ShouldContain(diagnostic => diagnostic.Code == "STAGE-ESM-007");
+    [Fact] void should_not_let_an_opaque_query_cover_an_unbacked_executable_query() => _declarativeQuery.Diagnostics.ShouldContain(diagnostic => diagnostic.Code == "STAGE-ESM-007");
+    [Fact] void should_preserve_unrelated_generated_command_bytes() => _after.ShouldEqual(_before);
+}
