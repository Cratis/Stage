<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>Notifier</AssemblyName>
        <RootNamespace>Cratis.Stage.Samples.Notifier</RootNamespace>
        <!-- Program.cs is the entry point; a test-SDK AutoGeneratedProgram would clash with it. -->
        <GenerateProgramFile>false</GenerateProgramFile>
        <NoWarn>$(NoWarn);CS7022</NoWarn>
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../../../Source/Extensions/DotNET/Cratis.Stage.Extensions.csproj" />
    </ItemGroup>
</Project>
