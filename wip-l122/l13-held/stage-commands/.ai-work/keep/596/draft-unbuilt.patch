+        _missingType = performed_query_model.Plan(compilation, [.. requirements.Select(requirement => requirement with
+        {
+            QueryShape = requirement.QueryShape! with { Arguments = [.. requirement.QueryShape!.Arguments.Select(argument => argument with { Type = null })] }
+        })]);
+    }
+
+    [Fact] void should_refuse_an_absent_descriptor() => _missingShape.Success.ShouldBeFalse();
+    [Fact] void should_explain_an_absent_descriptor() => _missingShape.Diagnostics.ShouldContain(diagnostic => diagnostic.Code == "STAGE-ESM-066" && diagnostic.Message.Contains("no query shape", StringComparison.Ordinal));
+    [Fact] void should_refuse_an_unresolved_return_model() => _missingModel.Diagnostics.ShouldContain(diagnostic => diagnostic.Code == "STAGE-ESM-066" && diagnostic.Message.Contains("read model is unresolved", StringComparison.Ordinal));
+    [Fact] void should_refuse_an_unresolved_argument_type() => _missingType.Diagnostics.ShouldContain(diagnostic => diagnostic.Code == "STAGE-ESM-066" && diagnostic.Message.Contains("unresolved type", StringComparison.Ordinal));
+    [Fact] void should_emit_no_partial_application() => _missingType.Artifacts.ShouldBeEmpty();
+}
