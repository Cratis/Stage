<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>Cratis.Stage.Specifications</AssemblyName>
        <RootNamespace>Cratis.Stage.Specifications</RootNamespace>
        <IsPackable>true</IsPackable>
        <!-- Type discovery references deprecated structural types from the Stage dependency. -->
        <NoWarn>$(NoWarn);CS0618</NoWarn>
        <!-- This new package has no published 3.15.1 baseline to compare against. -->
        <EnablePackageValidation>false</EnablePackageValidation>
        <Description>Isolated in-memory Screenplay semantic specification execution.</Description>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Stage/Stage.csproj" />
        <PackageReference Include="Cratis.Arc.Testing" />
        <PackageReference Include="Cratis.Arc.Chronicle.Testing" />
        <PackageReference Include="Cratis.Chronicle.Testing" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Cratis.Screenplay.CanonicalCorpus" PrivateAssets="All" />
    </ItemGroup>
</Project>
