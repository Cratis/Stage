+
+public class when_refusing_unresolved_performer_shapes : Specification
+{
+    ArtifactRenderPlan _missingShape = null!;
+    ArtifactRenderPlan _missingModel = null!;
+    ArtifactRenderPlan _missingType = null!;
+
+    void Because()
+    {
+        var compilation = performed_query_model.Compile();
+        var requirements = compilation.ImplementationRequirements;
+        _missingShape = performed_query_model.Plan(compilation, [.. requirements.Select(requirement => requirement with { QueryShape = null })]);
