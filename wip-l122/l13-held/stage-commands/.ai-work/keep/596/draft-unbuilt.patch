+
+using Cratis.Screenplay.Semantics;
+using Cratis.Stage.Rendering.Cratis.Naming;
+using Cratis.Stage.Rendering.Cratis.Semantics;
+
+namespace Cratis.Stage.Rendering.Cratis.Scene;
+
+/// <summary>Indexes generated proxies without treating opaque queries as executable queries.</summary>
+internal static class RenderedQueryBindings
+{
+    internal static IEnumerable<Binding> All(SemanticApplicationContext context) =>
+        context.Queries.Values.Select(query => new Binding(query.Id, query.Name, context.MemberNames.Query(query), Module(context.DeclaringSlice(query.Id)), query.Delivery))
+            .Concat(context.PerformedQueries.Select(query => new Binding(query.Id, query.Name, query.Method(context.ReadModels[query.Shape!.ReadModel!.Value]), Module(query.Slice), query.Shape.Delivery)));
+
+    static string Module(LocatedSemanticSlice slice) =>
+        "../" + string.Join('/', SliceNaming.FolderPath(slice.Path));
+
+    internal sealed record Binding(SemanticId Id, string Name, string Export, string Module, SemanticQueryDelivery Delivery);
+}
