+// Copyright (c) Cratis. All rights reserved.
+// Licensed under the MIT license. See LICENSE file in the project root for full license information.
+
+using Cratis.Screenplay.Semantics;
+using Cratis.Screenplay.Semantics.Execution;
+using Cratis.Specifications;
+using Cratis.Stage.Api;
+using Cratis.Stage.Host.for_SemanticRuntime.given;
+using Cratis.Stage.Semantics;
+using Microsoft.AspNetCore.Http;
+using Xunit;
+
+namespace Cratis.Stage.Host.for_SemanticRuntime;
+
+public class when_admitting_a_performer_query : Specification
+{
+    SemanticRuntimeAdmission _admission = null!;
+    SemanticExecutionResult _result = null!;
+    SemanticRuntimeQueryPerformerProvider _provider = null!;
+    SemanticId _query;
+
+    void Because()
+    {
+        const string source = """
+            module Billing
+              feature Invoices
+                slice StateView Figures
+                  readmodel Figures
+                    total Int
+                  query CurrentFigures => Figures[]
+                    performer
+                      file Queries/CurrentFigures.cs
+            """;
+        var catalog = SemanticIdentityCatalog.Empty(ApplicationIdentity.Create("Figures"));
+        var document = SemanticSourceDocument.Create(catalog.ResolveDocument("figures"), "figures", "Figures.play", source);
+        var compilation = new SemanticModelCompiler().Compile("Figures", SemanticDocumentSet.Create([document], catalog));
+        Assert.True(compilation.Success, string.Join(Environment.NewLine, compilation.Diagnostics));
+        var requirement = Assert.Single(compilation.ImplementationRequirements);
+        _query = requirement.Source!.SemanticId;
+        var plan = SemanticExecutionPlan.Compile(compilation.Value!.Model).Plan!;
+        _admission = new(plan, requirements: compilation.ImplementationRequirements);
+        _result = new SemanticEvaluator().Execute(plan, SemanticWorld.Empty,
+            SemanticExecutionRequest.ForQueries([new(_query, new SemanticNullValue())]));
+        var runtime = new a_semantic_fact_log().Runtime(plan, SemanticWorld.Empty);
+        _provider = new([runtime], [new DynamicTypeFactory()], [new HttpContextAccessor { HttpContext = new DefaultHttpContext() }]);
+    }
+
+    [Fact] void should_describe_the_query_as_unsupported() => _admission.Entries.ShouldContain(entry => entry.Artifact == _query.ToString() && entry.Kind == "query" && entry.Status == "unsupported" && entry.Details!.Contains("STAGE-IMPL-002", StringComparison.Ordinal));
+    [Fact] void should_not_refuse_loading_the_application() => _admission.BlockingIssues.ShouldBeEmpty();
+    [Fact] void should_not_register_a_conventional_or_opaque_query_performer() => _provider.Performers.ShouldBeEmpty();
+    [Fact] void should_preserve_the_reference_executors_explicit_refusal() => _result.ShouldBeOfExactType<SemanticUnsupported>();
+    [Fact] void should_not_fake_an_empty_answer() => ((SemanticUnsupported)_result).Capability.ShouldEqual(SemanticExecutionCapability.Query);
+}
