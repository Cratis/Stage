{
  "name": "@cratis/stage.runtime",
  "version": "0.0.0",
  "description": "The Cratis Stage application runtime for Arc and Scene",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cratis/Stage.git",
    "directory": "Source/Frontend/Runtime"
  },
  "publishConfig": { "access": "public" },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./vite": { "types": "./dist/styledPrimeReact.d.ts", "import": "./dist/styledPrimeReact.js" },
    "./styles.css": "./dist/src/app.css"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json tsconfig.specs.json && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('src/app.css', 'dist/src/app.css');\"",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@cratis/arc": "22.112.1",
    "@cratis/arc.react": "22.112.1",
    "@cratis/components": "4.29.0",
    "@cratis/fundamentals": "7.25.1",
    "@cratis/scene.blueprint.default": "4.68.2",
    "@cratis/scene.components": "4.68.2",
    "@cratis/scene.engine": "4.68.2",
    "@cratis/scene.model": "4.68.2",
    "@cratis/scene.primereact": "4.68.2",
    "@cratis/scene.react": "4.68.2",
    "@primereact/core": "11.2.0",
    "@primereact/headless": "11.2.0",
    "@primereact/ui": "11.2.0",
    "@primeuix/themes": "3.0.1",
    "primeicons": "8.0.2",
    "primereact": "11.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "tsyringe": "4.10.0",
    "vite": "8.3.2"
  }
}
